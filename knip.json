{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignore": [
    "apps/desktop/build/afterPack.cjs",
    "apps/desktop/src/preload.ts",
    "apps/mobile/assets/brand/generate-icons.mjs",
    "apps/mobile/modules/notification-listener/**",
    "apps/mobile/plugins/**",
    "docs/money-app/project/**",
    "supabase/functions/**"
  ],
  "workspaces": {
    "apps/mobile": {
      // fix-plan item 4.3: apps/mobile/src's remaining "unused export"
      // findings (after the genuinely dead ones were deleted — see the
      // fix-plan report) are all exports consumed only within their own
      // defining file (e.g. `resetLocalState` in `src/hooks/useAuth.ts`,
      // called by that file's own `onAuthStateChange` listener, never
      // imported elsewhere). That is real, load-bearing usage knip's
      // default "used by another file" heuristic can't see — not dead
      // code — so this scopes the fix to knip's own purpose-built knob
      // for the pattern rather than deleting live code or leaving the
      // whole workspace on `continue-on-error`.
      //
      // Boolean form, not the per-kind object (`{ function: true, ... }`):
      // knip (6.32, oxc-parser backed) tags plain `export const X = <array
      // literal>` declarations — e.g. `MIGRATIONS`/`*_COLUMNS` in
      // `src/services/sync/localDb.ts` — with an internal `unknown` symbol
      // type, and its own `shouldCountRefs` gate
      // (node_modules/knip/dist/typescript/ast-nodes.js) hard-excludes
      // `unknown` from the per-kind object form (`type !== 'unknown'`) —
      // only the blanket boolean bypasses that check.
      "ignoreExportsUsedInFile": true,
      "ignoreDependencies": [
        // `@babel/core` — genuine false positive, not dead: Metro invokes
        // `babel.config.js` (`module.exports = function (api) { ... }`)
        // through it at build time; nothing in source ever
        // `require('@babel/core')` directly, which is what leaves this
        // devDependency permanently unresolvable by knip's static import
        // scan no matter how the config is tuned.
        "@babel/core",
        // `expo-updates` — NOT a false positive, deliberately left
        // unresolved: knip's Expo plugin (node_modules/knip/dist/plugins/
        // expo/helpers.js) infers this dependency whenever app.config.js
        // has no `updates` key, because Expo's own default is
        // `updates.enabled !== false`. That default is real — this app
        // has never installed `expo-updates` or configured an EAS Update
        // channel, so OTA updates are silently unavailable today even
        // though the config doesn't say so. Fixing it for real means
        // either declaring `updates: { enabled: false }` in
        // `app.config.js` (an explicit opt-out) or installing
        // `expo-updates` and wiring up a channel (opting in) — both are
        // release-pipeline decisions (see the locked TestFlight-only
        // distribution decision in memory / docs/PLAN.md), not something
        // to default silently. This entry only keeps the finding from
        // blocking the gate; it does not resolve it — flagged in the
        // fix-plan report for a decision.
        "expo-updates"
      ]
    },
    "apps/web": {
      // Same false-positive category as apps/mobile above, scoped to this
      // workspace's own two cases: `DataFetchError`
      // (src/lib/data.ts) is thrown by every reader in that file and
      // caught generically by Next's `dashboard/error.tsx` boundary — no
      // call site imports the class itself to `instanceof`-check it — and
      // `LENS_KEYS` (src/components/lenses/types.ts) backs that file's
      // own `isLensKey` (which *is* imported elsewhere; the array literal
      // it closes over isn't).
      "ignoreExportsUsedInFile": true
    },
    "packages/ai": {
      // `WINDOW_NAMES` (src/askMurmurTools.ts) backs that file's own
      // `WindowName` type guard and JSON-schema `enum` fields — every
      // reference is within askMurmurTools.ts itself; nothing outside the
      // file needs the array symbol directly.
      "ignoreExportsUsedInFile": true
    }
  }
}
