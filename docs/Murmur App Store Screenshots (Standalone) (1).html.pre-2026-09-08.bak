"<!DOCTYPE html>\n<html><head>\n<meta charset=\"utf-8\">\n<title>Murmur — App Store Screenshots<\u002Ftitle>\n\n\n\n\n\n\n\n\n<style>\n  @keyframes blink { 0%,50% { opacity: 1 } 50.01%,100% { opacity: 0 } }\n  @keyframes voiceEdgeA { 0%,100% { opacity: .58 } 50% { opacity: 1 } }\n  @keyframes voiceEdgeB { 0%,100% { opacity: .35 } 50% { opacity: .85 } }\n  @keyframes voiceEdgeC { 0%,100% { opacity: .25 } 50% { opacity: .7 } }\n  @keyframes waveBar { 0%,100% { transform: scaleY(.28) } 50% { transform: scaleY(1) } }\n  @keyframes dotPulse { 0%,100% { opacity: 1; box-shadow: 0 0 0 0 rgba(63,90,62,.5) } 50% { opacity: .7; box-shadow: 0 0 0 5px rgba(63,90,62,0) } }\n  @keyframes riseIn { from { transform: translateY(14px); opacity: 0 } to { transform: translateY(0); opacity: 1 } }\n  @keyframes sheetUp { from { transform: translateY(60px); opacity: .4 } to { transform: translateY(0); opacity: 1 } }\n  html, body { margin: 0; padding: 0; background: #E9E6DF;\n    font-family: -apple-system, BlinkMacSystemFont, \"SF Pro Text\", system-ui, sans-serif; }\n  * { box-sizing: border-box; }\n  #root * { backdrop-filter: none !important; -webkit-backdrop-filter: none !important; }\n  a { color: #3F5A3E } a:hover { color: #1B1915 }\n<\u002Fstyle>\n<script src=\"cb2a7cbe-52ee-4623-9277-5a1629fdc73b\" integrity=\"sha384-hD6/rw4ppMLGNu3tX5cjIb+uRZ7UkRJ6BPkLpg4hAu/6onKUg4lLsHAs9EBPT82L\" crossorigin=\"anonymous\"><\u002Fscript>\n<script src=\"999e07ca-b393-458a-a93c-dcfe696ad48a\" integrity=\"sha384-u6aeetuaXnQ38mYT8rp6sbXaQe3NL9t+IBXmnYxwkUI2Hw4bsp2Wvmx4yRQF1uAm\" crossorigin=\"anonymous\"><\u002Fscript>\n<script src=\"98919afb-fde8-482c-98c9-d4cc7212655b\" integrity=\"sha384-m08KidiNqLdpJqLq95G/LEi8Qvjl/xUYll3QILypMoQ65QorJ9Lvtp2RXYGBFj1y\" crossorigin=\"anonymous\"><\u002Fscript>\n<\u002Fhead>\n<body>\n<div id=\"root\"><\u002Fdiv>\n<script src=\"c11ee59d-d08e-4e70-9628-102cc84f47d4\"><\u002Fscript>\n<script type=\"text/babel\" src=\"112d40c9-ae49-4693-ad5c-eb1ffe425ade\"><\u002Fscript>\n<script type=\"text/babel\" src=\"2b0f6071-4fb3-4681-9ff3-a33a488e6d79\"><\u002Fscript>\n<script type=\"text/babel\" src=\"d7e6e362-c971-4c70-9391-4b846a6e4700\"><\u002Fscript>\n<script type=\"text/babel\" src=\"81b2964e-5811-44e0-ad5d-3c2ad1df94f1\"><\u002Fscript>\n<script type=\"text/babel\" src=\"6399a87c-625c-443b-b9c3-c79fbe600677\"><\u002Fscript>\n<script type=\"text/babel\" src=\"1f31d104-8904-44b7-a3d7-beb560d21031\"><\u002Fscript>\n<script type=\"text/babel\" src=\"dc8818ed-08ac-4019-b5e4-1321c35c7fbd\"><\u002Fscript>\n<script type=\"text/babel\" src=\"3d429104-3078-4625-9773-2f20f82fd0e6\"><\u002Fscript>\n<script type=\"text/babel\" src=\"f14fb681-9185-4b14-b4e0-4e72777861f1\"><\u002Fscript>\n<script type=\"text/babel\" src=\"5e7d555d-7875-4a26-83c7-25dafcc718fe\"><\u002Fscript>\n<script type=\"text/babel\" src=\"f360afcd-d0e3-4dd0-9ad6-1dfee0609abe\"><\u002Fscript>\n<script type=\"text/babel\" src=\"c0ea2791-26eb-40d3-ba25-332af3c479db\"><\u002Fscript>\n<script type=\"text/babel\" src=\"82c1758e-1cd5-48eb-aa58-d189bf17cb66\"><\u002Fscript>\n<script type=\"text/babel\" src=\"a8555fed-a7f3-4787-97c8-01e9fed17342\"><\u002Fscript>\n<script type=\"text/babel\" src=\"37b378a3-7270-4311-9778-4690e95a9413\"><\u002Fscript>\n<script type=\"text/babel\" src=\"912fce52-cfeb-48dc-95bc-d97a644b7f32\"><\u002Fscript>\n<script type=\"text/babel\" src=\"05de743c-9665-4810-864c-5c1a0dac77ee\"><\u002Fscript>\n<script type=\"text/babel\" src=\"4e6672d7-d21b-4277-960c-e6e4f54615b1\"><\u002Fscript>\n<script type=\"text/babel\" src=\"6dec22e9-e873-4928-8583-df099b1e7dd6\"><\u002Fscript>\n<script type=\"text/babel\" src=\"7ea1187f-2810-418e-8f91-da7c0d10a212\"><\u002Fscript>\n<script type=\"text/babel\">\nfunction Section({ kicker, title, meta, children }) {\n  return (\n    <div style={{ marginBottom: 96 }}>\n      <div style={{ maxWidth: 2080, marginBottom: 28 }}>\n        <div style={{ fontSize: 13, fontWeight: 700, letterSpacing: 2.4, textTransform:'uppercase', color:'#3F5A3E', marginBottom: 8 }}>{kicker}<\u002Fdiv>\n        <div style={{ display:'flex', alignItems:'baseline', gap: 18, flexWrap:'wrap' }}>\n          <h2 style={{ margin: 0, fontFamily:'\"New York\",\"Iowan Old Style\",Georgia,serif', fontWeight: 600, fontSize: 34, letterSpacing: -0.8, color:'#1B1915' }}>{title}<\u002Fh2>\n          <span style={{ fontFamily:'\"SF Mono\",Menlo,monospace', fontSize: 13, color:'#8A857A' }}>{meta}<\u002Fspan>\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <div style={{ display:'flex', flexWrap:'wrap', gap: 56, alignItems:'flex-start' }}>{children}<\u002Fdiv>\n    <\u002Fdiv>\n  );\n}\nfunction Page() {\n  return (\n    <div style={{ padding:'64px 64px 120px', minWidth: 2200 }}>\n      <div style={{ marginBottom: 72, maxWidth: 900 }}>\n        <div style={{ display:'flex', alignItems:'center', gap: 12, marginBottom: 18 }}>\n          <DropMark size={44}/>\n          <span style={{ fontFamily:'\"New York\",Georgia,serif', fontWeight: 600, fontSize: 30, letterSpacing: -0.5, color:'#1B1915' }}>Murmur — App Store screenshots<\u002Fspan>\n        <\u002Fdiv>\n        <div style={{ fontSize: 16, lineHeight: 1.55, color:'#6C675E' }}>\n          Every canvas is authored at ½ scale and exports at 2× to Apple's exact pixel sizes (shown under each shot).\n          All UI and every claim is checked against the shipped build: Apple Pay capture, budgets, insights and forecasts are free; Ask Murmur, auto recurring, export and desktop are Murmur Plus, which is code-complete but not yet purchasable.\n        <\u002Fdiv>\n      <\u002Fdiv>\n      <Section kicker=\"App Store · iPhone\" title=\"iPhone 6.5-inch\" meta=\"1284 × 2778 px · portrait · max 10\">\n        <AS_IphoneShots/>\n      <\u002FSection>\n      <Section kicker=\"App Store · iPad\" title=\"iPad Pro 13-inch\" meta=\"2064 × 2752 px · portrait · composed marketing canvases\">\n        <AS_IpadShots/>\n      <\u002FSection>\n      <Section kicker=\"Marketing site\" title=\"Murmur for Mac\" meta=\"2880 × 1800 px · not for App Store submission\">\n        <AS_DesktopShots/>\n      <\u002FSection>\n    <\u002Fdiv>\n  );\n}\nReactDOM.createRoot(document.getElementById('root')).render(<Page/>);\n<\u002Fscript>\n\n\n<\u002Fbody><\u002Fhtml>"
  </script>
</body>
