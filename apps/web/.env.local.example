# Web (Next.js) — copy to .env.local for local dev. Deployments get these
# from Vercel project settings: Preview environment = staging Supabase
# project, Production environment = production project. Never point a
# non-production environment at the production Supabase project.

# Supabase — publishable values from Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-key-here

# OpenAI — powers /api/ai/* (parse-expense, parse-scan, ask-murmur)
OPENAI_API_KEY=your-openai-api-key

# Optional model overrides (default: gpt-4o-mini)
AI_PARSE_MODEL=gpt-4o-mini
AI_SCAN_MODEL=gpt-4o-mini
AI_ASK_MODEL=gpt-4o-mini

# Payload-bearing AI logs (question text, data overview, tool args/results) — leave unset in production
AI_DEBUG_TRACE=
