{
  "name": "@voice-expense/desktop",
  "productName": "Murmur",
  "version": "0.1.0",
  "private": true,
  "description": "Murmur desktop app — Electron shell serving the Next.js web UI from an embedded standalone server; /api/ai/* is forwarded to the hosted deployment so no server secret exists on the user's machine.",
  "main": "dist/main.js",
  "scripts": {
    "build:main": "tsc -p tsconfig.json",
    "build:web": "npm --prefix ../web run build && node scripts/bundle-web.mjs",
    "build": "npm run build:web && npm run build:main",
    "dev": "npm run build:main && electron .",
    "pack": "npm run build && electron-builder --mac --x64 --arm64 --dir",
    "dist": "npm run build && electron-builder --mac --x64 --arm64",
    "dist:win": "npm run build && electron-builder --win --x64",
    "icns": "node scripts/generate-icns.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@voice-expense/shared": "*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "electron": "33.4.11",
    "electron-builder": "25.1.8",
    "png-to-ico": "^3.0.1",
    "sharp": "^0.33.5",
    "typescript": "^5.7.3"
  }
}
