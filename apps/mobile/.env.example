# Mobile (Expo) — copy to .env for local development. Only `expo start`
# reads this file; EAS builds ignore it and use the env of the selected
# build profile in apps/mobile/eas.json (production carries its values
# inline; development/preview resolve from EAS Environment Variables on
# expo.dev — fill those with staging values, never production's).
EXPO_PUBLIC_SUPABASE_URL=https://your-staging-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_your-staging-key
EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
